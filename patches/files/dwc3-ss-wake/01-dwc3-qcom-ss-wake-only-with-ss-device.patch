+/*
+ * Whether a SuperSpeed device is attached to this port of the USB3 root hub. Only then is the SuperSpeed
+ * PHY wake line meaningful: on an empty port the QMP PHY's autonomous receiver detection keeps ss_phy_irq
+ * asserted once the system power-collapses, so arming it wakes the system immediately. New connections
+ * on an empty port still wake through the DP/DM lines.
+ */
+static bool dwc3_qcom_ss_device_attached(struct dwc3_qcom *qcom, int port_index)
+{
+	struct usb_hcd __maybe_unused *hcd;
+	struct usb_device *udev = NULL;
+	struct dwc3 *dwc = &qcom->dwc;
+
+	hcd = platform_get_drvdata(dwc->xhci);
+
+#ifdef CONFIG_USB
+	if (hcd && hcd->shared_hcd)
+		udev = usb_hub_find_child(hcd->shared_hcd->self.root_hub, port_index + 1);
+#endif
+	return udev && udev->speed >= USB_SPEED_SUPER;
+}
+
