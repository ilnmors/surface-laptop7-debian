#!/bin/sh
# Keep the homelab WireGuard tunnel (wg0) at MTU 1360.
# Over phone USB tethering the default 1420 black-holes larger packets (SSH/TLS stall while ping works).
# 1360 is the largest inner size measured to pass on 2026-11-16 (1370 failed); it also works on Wi-Fi.
[ "$1" = wg0 ] || exit 0
case "$2" in
  up|pre-up) ip link set dev wg0 mtu 1360 ;;
esac
