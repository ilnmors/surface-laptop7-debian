+static void spi_hid_resume_work(struct work_struct *work)
+{
+	struct spi_hid *shid = container_of(work, struct spi_hid, resume_work);
+	long left = (long)(shid->settle_until - jiffies);
+
+	if (left > 0)
+		msleep(jiffies_to_msecs(left));
+	if (READ_ONCE(shid->suspended))
+		return;
 	if (!cmpxchg(&shid->irq_enabled, false, true))
 		enable_irq(shid->spi->irq);
 
