[Unit]
Description=Set the Console account UID before user logins
After=local-fs.target
Before=systemd-user-sessions.service display-manager.service user@1001.service user@3000.service
ConditionPathExists=!/var/lib/surface-uid-migration/complete

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /var/lib/surface-uid-migration/migrate.py
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
