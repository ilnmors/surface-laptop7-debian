[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='Papirus-Dark'
accent-color='blue'
clock-show-weekday=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/sl7-debian.svg'
picture-uri-dark='file:///usr/share/backgrounds/sl7-debian.svg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/sl7-debian.svg'

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com']
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'sl7-codex.desktop', 'sl7-install-guide.desktop', 'org.gnome.Settings.desktop']
welcome-dialog-last-shown-version='48'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
intellihide=true
autohide=true
dash-max-icon-size=44
transparency-mode='FIXED'
background-opacity=0.88
show-trash=false
show-mounts=false

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
name='Terminal'
command='gnome-terminal'
binding='<Primary><Alt>t'
