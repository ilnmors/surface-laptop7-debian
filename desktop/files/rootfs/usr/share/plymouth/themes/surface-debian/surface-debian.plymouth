[Plymouth Theme]
Name=Surface Debian
Description=Debian logo with a simple boot spinner
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/surface-debian
Font=DejaVu Sans 12
TitleFont=DejaVu Sans 22
BackgroundStartColor=0x06080b
BackgroundEndColor=0x06080b
HorizontalAlignment=.5
VerticalAlignment=.67
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.36
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.55
MessageBelowAnimation=true
Transition=none
TransitionDuration=0.0

[boot-up]
UseEndAnimation=false
SuppressMessages=true

[shutdown]
UseEndAnimation=false
SuppressMessages=true

[reboot]
UseEndAnimation=false
SuppressMessages=true
