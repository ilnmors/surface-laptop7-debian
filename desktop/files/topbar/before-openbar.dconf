[extensions/blur-my-shell]
settings-version=8

[extensions/blur-my-shell/panel]
blur=true
corner-radius=14
force-light-text=false
override-background=false
static-blur=true
style-panel=2

[extensions/caffeine]
cli-toggle=false
enable-fullscreen=false
enable-mpris=false
indicator-position-max=2
restore-state=false
user-enabled=false

[extensions/dash-to-dock]
autohide=true
background-opacity=0.88
dash-max-icon-size=44
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
intellihide=true
show-mounts=false
show-trash=false
transparency-mode='FIXED'

[extensions/user-theme]
name='Fluent-Light'

[extensions/vitals]
battery-colors=@as []
gpu-colors=@as []
hot-sensors=['_processor_usage_', '_memory_usage_']
position-in-panel=2
show-battery=false
update-time=5

[world-clocks]
locations=@av []
